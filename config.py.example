# Copy to config.py and fill in your values. Do not commit config.py.

BOT_TOKEN = "123456:ABC-DEF..."
USER_ID = 123456789
URL = "https://your-domain.com/"
SECRET_KEY = "change-me-to-a-long-random-string"

RAPIDAPI_KEY = "your-rapidapi-key"
VDA_API_KEY = "your-vda-key"

DOWNLOAD_DIR = "downloads"
TEMP_LINKS_DIR = "temp_links"
MAX_SIZE = 50 * 1024 * 1024  # 50 MB — Telegram upload limit
EXPIRY = 24 * 3600  # secure link lifetime in seconds

# Optional directory for persistent bot logs (default: logs/ under the project root).
# LOG_DIR = "/var/log/vdownload"

# Optional Netscape cookies file for yt-dlp (Instagram rate limits / login).
# Leave "" to download without cookies. See README for how to export.
# Never commit the cookies file.
YTDLP_COOKIES_FILE = ""

# Optional SOCKS/HTTP proxy for yt-dlp on YouTube only (e.g. Cloudflare WARP).
# Leave "" to download YouTube without a proxy. Other sites (Instagram, etc.) ignore this.
# YTDLP_PROXY = "socks5://127.0.0.1:40000"
YTDLP_PROXY = ""
